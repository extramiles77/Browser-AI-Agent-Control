{
  "name": "@browser-ai-agent/extension",
  "version": "2.5.1",
  "private": true,
  "description": "Browser AI Agent Control's extension for Chrome and other Chromium browsers, built from source",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "wxt build && node scripts/sync-unpacked.ts",
    "build:dev": "wxt build --mode development",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "smoke": "wxt build --mode development && pnpm --filter @browser-ai-agent/mcp build && node scripts/smoke-browser-control.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@browser-ai-agent/extension-core": "workspace:*",
    "@browser-ai-agent/protocol": "workspace:*",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.18.3",
    "wxt": "^0.21.5"
  }
}
