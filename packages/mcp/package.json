{
  "name": "@browser-ai-agent/mcp",
  "version": "2.6.1",
  "description": "MCP server for browser automation using Browser AI Agent Control",
  "homepage": "https://github.com/extramiles77/Browser-AI-Agent-Control#readme",
  "bugs": "https://github.com/extramiles77/Browser-AI-Agent-Control/issues",
  "license": "Apache-2.0",
  "author": "Browser AI Agent Control",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/extramiles77/Browser-AI-Agent-Control.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "browser-ai-agent-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && shx chmod +x dist/index.js",
    "prepare": "npm run build",
    "watch": "tsup --watch",
    "test": "vitest run",
    "eval": "vitest run --config eval/vitest.config.ts",
    "inspector": "CLIENT_PORT=9001 SERVER_PORT=9002 pnpx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.1",
    "playwright-core": "1.65.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@browser-ai-agent/protocol": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "shx": "^0.4.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
